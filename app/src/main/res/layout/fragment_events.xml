<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingTop="4dp"
    tools:context=".EventsFragment">

    <HorizontalScrollView
        android:id="@+id/scrollCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutCategoryBtns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sve"
                android:backgroundTint="@color/grey"
                />

            <Button
                android:id="@+id/btnFilterParty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/party"
                android:backgroundTint="@color/grey"
                />

            <Button
                android:id="@+id/btnFilterFestival"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/festival"
                android:backgroundTint="@color/grey"
                />

            <Button
                android:id="@+id/btnFilterTheater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stand_up_theater"
                android:backgroundTint="@color/grey"
                />

            <Button
                android:id="@+id/btnFilterConcert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/concert"
                android:backgroundTint="@color/grey"
                />

            <Button
                android:id="@+id/btnFilterExhibition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exhibition"
                android:backgroundTint="@color/grey"
                />
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnAddEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dodaj_event"
        />

    <LinearLayout
        android:id="@+id/listContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_weight="1"
        >

        <ListView
            android:id="@+id/listEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            />

        <TextView
            android:id="@+id/txtNoEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/no_upcoming_events"
            android:gravity="center"
            android:visibility="gone"
            />
    </LinearLayout>

</LinearLayout>